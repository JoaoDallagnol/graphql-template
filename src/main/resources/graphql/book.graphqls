# Book queries and mutations

extend type Query {
    # Fetches all books
    books: [Book!]

    # Fetches a single book by ID
    bookById(id: ID!): Book

    # Fetches all books written by a specific author
    booksByAuthor(id: ID!): [Book!]

    # Fetches books with optional filters
    booksWithFilter(
        id: ID
        authorId: ID
        name: String
    ): [Book!]
}

type Book {
    id: ID
    name: String
    pageCount: Int
    author: Author
}

# Input type for book creation and updates
input BookInput {
    name: String!
    pageCount: Int!
    authorId: ID!
}

extend type Mutation {
    # Creates a new book
    createBook(book: BookInput!): Book!
    
    # Updates an existing book by ID
    updateBook(id: ID, book: BookInput): Book!
    
    # Deletes a book by ID
    deleteBook(id: ID!): ID!
}