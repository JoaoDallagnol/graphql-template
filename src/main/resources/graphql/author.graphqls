# Author queries and mutations

extend type Query {
    # Fetches all authors
    authors: [Author!]

    authorsWithPagination(first: Int, after: String, last: Int, before: String): AuthorConnection
}

# Author type definition
type Author {
    id: ID
    firstName: String
    lastName: String
}

# Input type for author creation and updates
input AuthorInput {
    firstName: String!
    lastName: String!
}

extend type Mutation {
    # Creates a new author
    createAuthor(author: AuthorInput!): Author!
    
    # Updates an existing author by ID
    updateAuthor(id: ID!, author: AuthorInput!): Author!
    
    # Deletes an author by ID
    deleteAuthor(id: ID!): ID!
}

### Pagination declaration ###
type AuthorConnection {
    edges: [AuthorEdge]
    pageInfo: PageInfo
    totalCount: Int
}

type AuthorEdge {
    node: Author
    cursor: String
}

type PageInfo {
    hasNextPage: Boolean!
    hasPreviousPage: Boolean!
    startCursor: String
    endCursor: String
}